{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_version", "scope", "levels", "counts", "audio_available", "stroke_assets_available", "authorship", "metadata_sources", "limitations_vi"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "content_version": {"type": "integer", "minimum": 1},
    "scope": {"const": "original_seed_not_full_curriculum"},
    "levels": {"type": "array", "items": {"enum": ["N5", "N4"]}, "minItems": 1, "uniqueItems": true},
    "counts": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "patternProperties": {"^N[45]$": {
        "type": "object", "additionalProperties": false,
        "required": ["vocabulary", "kanji", "grammar", "examples"],
        "properties": {
          "vocabulary": {"type": "integer", "minimum": 1},
          "kanji": {"type": "integer", "minimum": 1},
          "grammar": {"type": "integer", "minimum": 1},
          "examples": {"type": "integer", "minimum": 1}
        }
      }}
    },
    "audio_available": {"type": "boolean"},
    "stroke_assets_available": {"type": "boolean"},
    "authorship": {"type": "string", "minLength": 1},
    "metadata_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "limitations_vi": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
