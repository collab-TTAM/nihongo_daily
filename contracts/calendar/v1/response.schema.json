{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nihongo-daily:profile-study-day:1:response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "timezone"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "minLength": 10,
      "maxLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9_+-]+(?:/[A-Za-z0-9_+-]+)*$",
      "not": {
        "pattern": "\\s"
      }
    }
  }
}
