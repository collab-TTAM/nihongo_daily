{
  "name": "@nihongo-daily/ai-boundary",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "format": "prettier --write src test *.json",
    "format:check": "prettier --check src test *.json",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "test:postgres-quota": "node --test test/postgres_quota.native.ts",
    "test:postgres-text": "node --test test/postgres_text_context.native.ts",
    "test:postgres-conversation": "node --test test/postgres_conversation.native.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/pg": "8.23.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
